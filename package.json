{
  "name": "pt-depiler",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "homepage": "https://github.com/pt-plugins/PT-depiler",
  "packageManager": "pnpm@10.21.0",
  "author": {
    "name": "Pt-Plugins",
    "url": "https://github.com/pt-plugins"
  },
  "maintainers": [
    {
      "name": "Rhilip",
      "url": "https://github.com/Rhilip"
    }
  ],
  "contributors": [
    {
      "name": "ronggang",
      "url": "https://github.com/ronggang"
    },
    {
      "name": "ted423",
      "url": "https://github.com/ted423"
    }
  ],
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "format": "prettier --list-different -w ./",
    "format:check": "prettier --check package.json vitest.config.ts docs/2026-09-11-Tauri网络与认证层执行计划.md src/extends/axios/*.ts src/packages/backupServer/entity/WebDAV.ts src/entries/background/utils/cookie*.ts src/entries/options/stores/metadata.ts src/entries/options/service/siteLogin*.ts src/entries/options/service/fixtures/*.html src/entries/options/views/Settings/SetSite/LoginDialog.*",
    "check": "vue-tsc --noEmit",
    "check:architecture": "tsx scripts/check-architecture-boundaries.ts",
    "test": "vitest run",
    "build:dist": "vite build",
    "build:watch": "vite build --watch --mode development --minify false",
    "action:upload_telegram": "tsx vite/sendToTgChannel.ts",
    "release:changelog": "conventional-changelog -p angular && git add CHANGELOG.md",
    "verify:desktop": "pnpm format:check && pnpm check && pnpm check:architecture && pnpm test && pnpm build:dist && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && pnpm tauri build --debug --no-bundle"
  },
  "engines": {
    "node": ">=23.7.0",
    "pnpm": ">=10.14.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.49.0",
    "file-saver": "^2.0.5",
    "filesize": "^11.0.22",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "nanoid": "^5.1.16",
    "p-queue": "^9.3.1",
    "parse-torrent": "^11.0.21",
    "pinia": "^3.0.4",
    "pinia-plugin-state-persistence": "^1.11.0",
    "search-query-parser": "^1.6.0",
    "sizzle": "^2.3.10",
    "url-join": "^5.0.0",
    "urlencode": "^2.0.0",
    "valid-filename": "^4.0.0",
    "vue": "3.5.39",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.6",
    "vue-konva": "^3.4.0",
    "vue-router": "5.3.1",
    "vuetify": "^3.12.7",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/git-rev-sync": "^2.0.2",
    "@types/node": "^26.1.1",
    "@types/parse-torrent": "^5.8.8",
    "@types/sizzle": "^2.3.10",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "^2.5.0",
    "git-rev-sync": "^3.0.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.7"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "vueIndentScriptAndStyle": false,
    "endOfLine": "lf"
  }
}
