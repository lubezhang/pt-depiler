{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PT-depiler",
  "version": "0.0.6",
  "identifier": "com.ptplugins.pt-depiler",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PT-depiler",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
